{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cdssp-github-io",
  "compatibility_date": "2025-09-27",
  "assets": {
    "directory": ".",
    "not_found_handling": "404-page"
  },
  "base_dir": ".",
  "ignore_assets": [
    "node_modules",
    ".git",
    ".github",
    ".dev.vars",
    ".dev.vars.production",
    "src",
    "signal",
    "worker",
    "research",
    "docs",
    "package.json",
    "package-lock.json",
    "build.js",
    "build-brand.js",
    "wrangler.jsonc",
    "_config.yml"
  ]
}
