{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "doubletrends",
  "compatibility_date": "2025-09-27",
  "workers_dev": false,
  "preview_urls": false,
  // doubletrends.com is the canonical origin (src/site.config.js SITE_URL).
  // Declared here so production routing lives in version control rather than
  // only in the dashboard.
  "routes": [
    {
      "pattern": "doubletrends.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
