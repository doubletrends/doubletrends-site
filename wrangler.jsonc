{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cdssp-github-io",
  "compatibility_date": "2025-09-27",
  "assets": {
    "directory": "."
  },
  "base_dir": ".",
  "ignore_assets": [
    "node_modules",
    ".git",
    "src",
    "package.json",
    "build.js",
    "wrangler.jsonc"
  ]
}