{
  "name": "dtep-subscriptions",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-24",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dtep",
      "database_id": "9a0d6893-99cc-43aa-b86f-3f0ddb1e12e2"
    }
  ]

  /*
   * Set these with wrangler secret put:
   * TELEGRAM_BOT_TOKEN
   * TELEGRAM_BOT_USERNAME     (without @, e.g. DoubleTrendsBot — used to build the t.me activation deep link)
   * TELEGRAM_CHANNEL_ID
   * STRIPE_SECRET_KEY
   * STRIPE_WEBHOOK_SECRET
   * STRIPE_PRICE_ID
   * TELEGRAM_WEBHOOK_SECRET   (same value you pass as secret_token to setWebhook)
   * BRIEF_SHARED_SECRET       (must match the GitHub Actions secret used by signal/brief.py)
   */
}
