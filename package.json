{
  "name": "doubletrends",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "build": "node build.js",
    "brand": "node build-brand.js",
    "replay-data": "node build-replay-data.js",
    "test": "node build.js && node scripts/test-links.js && node scripts/test-trademark.js && node scripts/test-metadata.js && node scripts/test-page-registry.js && node scripts/test-schema.js && node scripts/test-overlines.js && node scripts/test-nav-consistency.js && node scripts/test-heading-consistency.js",
    "test:links": "node build.js && node scripts/test-links.js",
    "test:trademark": "node scripts/test-trademark.js",
    "test:metadata": "node build.js && node scripts/test-metadata.js",
    "test:registry": "node scripts/test-page-registry.js",
    "test:schema": "node build.js && node scripts/test-schema.js",
    "test:overlines": "node build.js && node scripts/test-overlines.js",
    "test:nav-consistency": "node build.js && node scripts/test-nav-consistency.js",
    "test:headings": "node build.js && node scripts/test-heading-consistency.js",
    "dev": "node build.js && wrangler dev",
    "deploy": "node build.js && wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4",
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/syne": "^5.2.7",
    "lightweight-charts": "^4.2.3",
    "opentype.js": "^2.0.0",
    "sharp": "^0.34.5"
  }
}
