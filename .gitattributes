# All text files normalize to LF in the repo; checkout uses native EOL per platform.
* text=auto eol=lf

# Common binary asset extensions — explicit so auto-detection never misfires.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.eot   binary
*.pdf   binary
