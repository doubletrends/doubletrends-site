# All text files normalize to LF in the repo and check out as LF on every platform.
* text=auto eol=lf

# Common binary asset extensions — explicit so auto-detection never misfires.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.eot   binary
*.pdf   binary

# Derived files committed because the build can't make them. Never hand-edit:
# change the source and rerun the generator named above each group.

# scripts/indicator-data.js (npm run indicator-data) — needs ../doubletrends-backend
src/data/indicator.json      linguist-generated
src/data/regimes-daily.json  linguist-generated
public/data/*.csv            linguist-generated

# scripts/archive-images.js (npm run archive-images) — needs the network
public/img/archive/*         linguist-generated
